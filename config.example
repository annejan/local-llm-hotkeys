# Copy to ~/.config/uktr/config. Env vars (UKTR_*) override this file.

# NPU via FastFlowLM (systemctl --user start flm):
UKTR_URL=http://localhost:52625/v1
UKTR_MODEL=translategemma:4b
# uktr listen: faster model so subtitles keep up
UKTR_LISTEN_MODEL=hy-mt2-flash:1.8b

# GPU via ollama:
#UKTR_URL=http://localhost:11434/v1
#UKTR_MODEL=gemma4:12b

# Target language (default English)
#UKTR_TO=English

# uktr shot: tesseract languages
#UKTR_OCR=ukr+eng

# uktr listen: spoken language for Whisper ("" = auto-detect, unreliable on short chunks)
#UKTR_LANG=uk
#UKTR_ASR_URL=http://localhost:52625/v1
#UKTR_ASR_MODEL=whisper-v3:turbo
#UKTR_LISTEN_MAX=12
#UKTR_SILENCE=300

# eli12: chat model that explains texts like you are 12 (translation models cannot)
#ELI12_MODEL=qwen3.5:9b
#ELI12_LANG=nl   # nl, en or both
#ELI12_SENTENCES=5   # longest explanation, in sentences

# fixtext and ask: chat models
#FIX_MODEL=qwen3.5:9b
#ASK_MODEL=qwen3.5:9b
#ASK_HISTORY=0   # do not save ask chats
